# Environment Configuration
# Copy this file to .env (or .env.production) and fill in the values for deployment.
# Leave both unset for local development — Vite's dev proxy (vite.config.js)
# forwards /api and /ws to http://localhost:8000 automatically.

# Base URL for backend API requests. Leave unset locally.
# Example (production): VITE_API_BASE_URL=https://api.example.com/api
VITE_API_BASE_URL=

# Base URL for WebSocket connections (ws:// or wss://). Leave unset locally.
# Example (production): VITE_WS_BASE_URL=wss://api.example.com
VITE_WS_BASE_URL=
