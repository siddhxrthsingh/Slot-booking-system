# Environment Configuration
# Copy this file to .env and fill in the values

# --- App ---
APP_ENV=development
SECRET_KEY=your-super-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- MongoDB ---
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/
MONGO_DB_NAME=slot_booking

# --- PESUAuth ---
PESU_AUTH_URL=https://pesuauth.example.com/api/login

# --- CORS ---
# Comma-separated list of allowed origins (no spaces around commas needed)
FRONTEND_ORIGIN=http://localhost:5173

# --- Rate Limiting ---
RATE_LIMIT_LOGIN=5/minute

# --- Admin (employee-ID based login, no external API) ---
# Change these in production — defaults are insecure.
ADMIN_EMPLOYEE_ID=EMP001
ADMIN_PASSWORD=change-this-in-production
ADMIN_NAME=Sports Admin
ADMIN_EMAIL=admin@pesu.edu

# --- Booking Policy ---
CANCEL_WINDOW_HOURS=2
BAN_DURATION_DAYS=2

# --- Email Notifications (optional — leave blank to disable) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@pesu.edu
